# ========================================================
# Medinex Project .gitignore
# Ensures sensitive keys, databases, and build artifacts
# are never committed when pushing to GitHub.
# ========================================================

# Sensitive environment files & API keys
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# Dependencies
node_modules/
**/node_modules/

# Production build artifacts
dist/
**/dist/
build/
**/build/

# Local databases and SQLite WAL/journal files
*.db
*.db-journal
*.db-wal
*.db-shm
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Log files
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
