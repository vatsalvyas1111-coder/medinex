# ---- Medinex server environment ----
PORT=4000
# App timezone: all "wall clock" times (dose schedules, demo clock) use this zone.
APP_TZ=Asia/Kolkata
# Long random string used to sign login cookies. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string
# Demo mode enables the Demo Panel endpoints (one-click role switch, time travel, scenarios, reset).
DEMO_MODE=true
# When seeding, start the demo clock at this local time today (HH:MM). Use "real" to follow the real clock.
SEED_CLOCK_START=07:30

# ---- Groq AI (server-side ONLY, never sent to the browser) ----
# Get a key at https://console.groq.com/keys . Without a key Medi falls back to a local, data-grounded responder.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Comma-separated fallbacks tried in order if the primary model id is rejected.
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
